<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
    <div class="col-12 col-md-10 col-lg-8 offset-md-1 offset-lg-2">
        <h3><%= listing.title %></h3>
    </div>

    <div class="card col-12 col-md-10 col-lg-8 offset-md-1 offset-lg-2 show-card listing-card">
        <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="listing_image">
        <div class="card-body mt-3">
            <p class="card-text">
                <span class="badge bg-danger text-white text-uppercase px-2 py-1 mb-2">
                    <i class="fa-solid fa-tag me-1"></i><%= listing.category || 'Trending' %>
                </span>
                <br>
                <i class="text-muted"><i class="fa-solid fa-user me-1"></i>Owned by <strong><%= listing.owner ? listing.owner.username : 'Host' %></strong></i>
            </p>
            <p class="card-text"><%= listing.description %></p>
            <p class="card-text">
                <i class="fa-solid fa-indian-rupee-sign me-1"></i><strong><%= listing.price.toLocaleString("en-IN") %></strong> / night
                <span class="text-muted" style="font-size: 0.85rem;">(&#8377; <%= Math.round(listing.price * 1.18).toLocaleString("en-IN") %> incl. 18% GST)</span>
            </p>
            <p class="card-text"><i class="fa-solid fa-location-dot text-danger me-1"></i><%= listing.location %>, <%= listing.country %></p>
        </div>
    </div>

    <% if(currUser && listing.owner && currUser._id.equals(listing.owner._id)) { %>
    <div class="btns col-12 col-md-10 col-lg-8 offset-md-1 offset-lg-2 mb-4">
        <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark edit-btn me-3"><i class="fa-solid fa-pen-to-square me-1"></i>Edit</a>
        <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="d-inline">
            <button class="btn btn-danger"><i class="fa-solid fa-trash-can me-1"></i>Delete</button>
        </form>
    </div>
    <% } %>

    <div class="col-12 col-md-10 col-lg-8 offset-md-1 offset-lg-2 mb-3">
        <% if(currUser) { %>
        <hr>
        <h4><i class="fa-regular fa-comment-dots me-2"></i>Leave a Review</h4>
        <form method="POST" action="/listings/<%= listing._id %>/reviews" novalidate class="needs-validation">
            <div class="mt-3 mb-3">
                <label for="rating" class="form-label">Rating</label>
                <fieldset class="starability-basic">
                    <legend></legend>
                    <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                    <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                    <label for="first-rate1" title="Terrible">1 star</label>
                    <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                    <label for="first-rate2" title="Not good">2 stars</label>
                    <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                    <label for="first-rate3" title="Average">3 stars</label>
                    <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                    <label for="first-rate4" title="Very good">4 stars</label>
                    <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                    <label for="first-rate5" title="Amazing">5 stars</label>
                </fieldset>
            </div>

            <div class="mt-3 mb-3">
                <label for="comment" class="form-label">Comments</label>
                <textarea name="review[comment]" id="comment" cols="30" rows="4" class="form-control" placeholder="Share your experience at this place..." required></textarea>
                <div class="invalid-feedback">Please add some comments for review</div>
            </div>
            <button class="btn btn-outline-dark"><i class="fa-solid fa-paper-plane me-1"></i>Submit Review</button>
        </form>
        <% } %>

        <% if(listing.reviews.length > 0) { %>
        <hr>
        <p><b><i class="fa-solid fa-star text-warning me-1"></i>All Reviews (<%= listing.reviews.length %>)</b></p>
        <div class="row">
            <% for(review of listing.reviews) { %>
                <div class="col-md-6 mb-3">
                    <div class="card h-100 p-3 shadow-sm border-0 bg-light">
                        <div class="card-body">
                            <h6 class="card-title"><i class="fa-solid fa-circle-user me-1 text-secondary"></i>@<%= review.author ? review.author.username : 'Traveler' %></h6>
                            <p class="starability-result" data-rating="<%= review.rating %>"></p>
                            <p class="card-text"><%= review.comment %></p>
                        </div>
                        <% if(currUser && review.author && currUser._id.equals(review.author._id)) { %>
                        <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" class="mt-2">
                            <button class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash me-1"></i>Delete</button>
                        </form>
                        <% } %>
                    </div>
                </div>
            <% } %>
        </div>  
        <% } %>     

        <hr>
        <div class="mb-4">
            <h4><i class="fa-solid fa-map-location-dot me-2 text-danger"></i>Where you'll be</h4>
            <p class="text-muted"><%= listing.location %>, <%= listing.country %></p>
            <div id="map" style="height: 350px; width: 100%; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);"></div>
        </div>
    </div>
</div>

<script>
    const listingLocation = "<%= listing.location %>, <%= listing.country %>";
    const listingTitle = "<%= listing.title %>";

    document.addEventListener("DOMContentLoaded", function () {
        // Initialize interactive Leaflet map
        const mapElement = document.getElementById('map');
        if (mapElement && typeof L !== 'undefined') {
            // Default center coordinates
            let defaultLat = 28.6139;
            let defaultLng = 77.2090;

            const map = L.map('map').setView([defaultLat, defaultLng], 12);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '© OpenStreetMap'
            }).addTo(map);

            // Geocode location using OpenStreetMap Nominatim API
            fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(listingLocation)}`)
                .then(res => res.json())
                .then(data => {
                    if (data && data.length > 0) {
                        const lat = parseFloat(data[0].lat);
                        const lon = parseFloat(data[0].lon);
                        map.setView([lat, lon], 13);
                        L.marker([lat, lon])
                            .addTo(map)
                            .bindPopup(`<b>${listingTitle}</b><br><i class="fa-solid fa-location-dot text-danger"></i> ${listingLocation}`)
                            .openPopup();
                    } else {
                        // Fallback marker
                        L.marker([defaultLat, defaultLng])
                            .addTo(map)
                            .bindPopup(`<b>${listingTitle}</b><br>${listingLocation}`)
                            .openPopup();
                    }
                })
                .catch(() => {
                    L.marker([defaultLat, defaultLng])
                        .addTo(map)
                        .bindPopup(`<b>${listingTitle}</b><br>${listingLocation}`)
                        .openPopup();
                });
        }
    });
</script>
